# Copy this file to ".env" and fill in your values. Never commit .env to GitHub.

PORT=3000
NODE_ENV=development

# Public address of the site (used inside emails). Use your https domain after deploying.
BASE_URL=http://localhost:3000

# Your existing MongoDB connection string (Atlas or local)
MONGO_URI=mongodb://127.0.0.1:27017/xabfakeguard

# Long random text. Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Development shortcut: true = new accounts count as verified (no email/SMS needed). Use false in production.
AUTO_VERIFY=true

# --- Email (forgot password + email verification). Leave empty in development: links print in the server console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Fake Guard <no-reply@yourdomain.com>"

# --- SMS (phone codes). Optional Twilio. Leave empty in development: codes print in the server console.
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=

# --- Social login (leave empty to hide the setup; the buttons will explain what is missing)
GOOGLE_CLIENT_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_API_VERSION=v25.0

# Sign in with Apple
APPLE_SERVICES_ID=com.xab.fakeguard.web
APPLE_BUNDLE_ID=com.xab.fakeguard
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Paste the .p8 key on ONE line, replacing line breaks with \n
APPLE_PRIVATE_KEY=

# --- Optional identity verification (Persona) ---
# Keep all secrets server-side. Configure a Persona inquiry template with document + selfie/liveness checks.
PERSONA_API_KEY=
PERSONA_TEMPLATE_ID=
PERSONA_WEBHOOK_SECRET=
PERSONA_API_VERSION=2026-09-29

# ================= AI features (new) =================
# Free key from https://aistudio.google.com/apikey  (leave empty = manual data only, no AI reading)
GEMINI_API_KEY=
# Tested Gemini Flash model. Set empty to discover the latest available model.
GEMINI_MODEL=gemini-2.5-flash
# Text request timeout (milliseconds).
GEMINI_TIMEOUT_MS=5500
# Vision request timeout (milliseconds).
GEMINI_IMAGE_TIMEOUT_MS=18000

# Password for the /manual admin page. Use a long random value. Empty = admin page disabled.
ADMIN_KEY=

# --- WebRTC calling: public STUN works for many networks; TURN is needed for restrictive NAT/firewalls.
# Deploy a TURN service (for example coturn with use-auth-secret) before setting these values.
# Use comma-separated ICE URLs, such as turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349.
# TURN_SHARED_SECRET must match the TURN server's REST shared secret; never expose it to the browser.
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
TURN_URLS=
TURN_SHARED_SECRET=

# Optional local vision and QR/barcode agents (see backend/agent/). Empty = Gemini fallback only.
PY_AGENT_URL=
# Optional shared secret between Node and the Python agent (set the same value in both places)
AGENT_TOKEN=
